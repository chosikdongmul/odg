---
import '@fontsource-variable/archivo/standard.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { faviconFor, img, team } from '../lib/data';

interface Props {
  title?: string;
}
const pageTitle = Astro.props.title ? `${Astro.props.title} — ${team.name}` : `${team.name}${team.nameKo ? ` · ${team.nameKo}` : ''}`;
const description = `${team.name} — ${team.league} ${team.city}. ${team.slogan ?? ''}`.trim();
const vars = `--accent:${team.theme.accent};--photo:${team.theme.paper}`;
const favicon = faviconFor(team.theme.accent);
// 카카오톡·디스코드 등에 링크를 붙였을 때 뜨는 미리보기
const share = img(team.shareImage);
const shareImg = share
  ? new URL((await getImage({ src: share, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href
  : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ko" style={vars} data-theme={team.theme.mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={team.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="ko_KR" />
    {shareImg && <meta property="og:image" content={shareImg} />}
    {shareImg && <meta property="og:image:width" content="1200" />}
    {shareImg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={shareImg ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImg && <meta name="twitter:image" content={shareImg} />}
    <link rel="icon" href={favicon} />
    <script is:inline>
      // 방문자가 고른 테마를 깜빡임 없이 먼저 적용
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
