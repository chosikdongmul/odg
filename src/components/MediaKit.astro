---
import { mediakit, tx, withBase } from '../lib/data';
import SectionHead from './SectionHead.astro';
---

{
  mediakit.length > 0 && (
    <section class="section" id="mediakit">
      <div class="wrap">
        <SectionHead label={tx.mediakit.label} title={tx.mediakit.title} aside={tx.mediakit.aside} />
        <ul class="kit">
          {mediakit.map((k, i) => (
            <li>
              <span class="idx num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{k.title}</strong>
              {k.description && <span class="muted desc">{k.description}</span>}
              {k.file ? (
                <a class="dl" href={withBase(k.file)} download>
                  {tx.mediakit.download}
                </a>
              ) : (
                <span class="soon">{tx.mediakit.soon}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .kit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    background: var(--bg);
  }
  .idx {
    font-size: 12px;
    color: var(--accent-text);
    margin-bottom: 8px;
  }
  strong {
    font-size: 16px;
  }
  .desc {
    font-size: 13px;
    flex: 1;
  }
  .dl,
  .soon {
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .dl {
    color: var(--accent-text);
  }
  .soon {
    color: var(--dim);
  }
</style>
