---
import { img, team, tx, withBase } from '../lib/data';
import Bolt from './Bolt.astro';
import Social from './Social.astro';

const s = team.sections;
const nav = [
  { href: '#roster', label: tx.nav.roster },
  { href: '#results', label: tx.nav.results, on: s.results },
  { href: '#schedule', label: tx.nav.schedule, on: s.schedule },
  { href: '#media', label: tx.nav.media, on: s.gallery },
  { href: '#partners', label: tx.nav.partners, on: s.partners || s.sponsorship },
  { href: '#store', label: tx.nav.store, on: s.store },
].filter((n) => n.on !== false);
const logo = img(team.logo);
---

<div class="top-fixed" data-top>
  {
    team.notice.enabled && team.notice.text && (
      <div class="notice" data-notice>
        <a href={team.notice.href ? withBase(team.notice.href) : undefined} class="notice-text">
          {team.notice.text}
        </a>
        <button class="notice-close" aria-label="공지 닫기" data-notice-close>
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
      </div>
    )
  }

  <header class="header" data-header>
    <div class="bar wrap">
      <a href="#top" class="brand" aria-label={`${team.name} 홈`}>
        {logo ? <span class="logo" style={`--logo:url("${logo.src}");--ratio:${logo.width / logo.height}`} /> : <Bolt class="mark" />}
        <span class="brand-text">
          <span class="name">{team.name}</span>
          <span class="sub">{team.nameKo ?? `${team.league} · ${team.city}`}</span>
        </span>
      </a>

      <nav class="nav" aria-label="주 메뉴">
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="tools">
        <Social links={team.socials} class="head-social" />
        <button type="button" class="icon-btn" data-theme-toggle aria-label="밝기 전환">
          <svg class="moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
          <svg class="sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
        <button class="icon-btn menu-btn" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <div class="mobile" id="mobile-menu" hidden data-menu>
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
      <Social links={team.socials} />
    </div>
  </header>
</div>

<script>
  const root = document.documentElement;
  const top = document.querySelector<HTMLElement>('[data-top]')!;
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // 공지 띠 높이만큼 히어로를 밀어내기 위해 전체 높이를 CSS 변수로
  const syncH = () => root.style.setProperty('--top-h', `${top.offsetHeight}px`);
  new ResizeObserver(syncH).observe(top);

  const notice = document.querySelector<HTMLElement>('[data-notice]');
  const key = notice?.textContent?.trim() ?? '';
  try {
    if (notice && sessionStorage.getItem('notice-closed') === key) notice.remove();
  } catch {}
  document.querySelector('[data-notice-close]')?.addEventListener('click', () => {
    try {
      sessionStorage.setItem('notice-closed', key);
    } catch {}
    notice?.remove();
  });

  document.querySelector('[data-theme-toggle]')!.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    menu.hidden = !open;
    header.classList.toggle('open', open);
    root.classList.toggle('menu-open', open);
  };
  btn.addEventListener('click', () => setMenu(menu.hidden === true));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  const onScroll = () => header.classList.toggle('scrolled', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .top-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
  .notice {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 44px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
  }
  a.notice-text[href]:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .notice-close {
    position: absolute;
    right: 10px;
    top: 50%;
    translate: 0 -50%;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    opacity: 0.7;
  }

  /* 히어로 위에서는 투명 + 흰 글씨, 스크롤하면 바탕색 */
  .header {
    color: #fff;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .header.scrolled,
  .header.open {
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    color: var(--text);
    border-bottom-color: var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  .brand :global(.mark) {
    height: 26px;
    color: var(--accent);
  }
  /* 로고 모양대로 글자색을 칠한다 → 영상 위에선 흰색, 스크롤 후엔 테마 글자색 */
  .logo {
    display: block;
    height: 26px;
    width: calc(26px * var(--ratio));
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .name {
    white-space: nowrap;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .sub {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-top: 3px;
  }
  .nav ul {
    display: flex;
    gap: 30px;
  }
  .nav a {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.75;
    transition: opacity 0.2s, color 0.2s;
  }
  .nav a:hover {
    opacity: 1;
    color: var(--accent-text);
  }
  .scrolled .nav a:hover {
    color: var(--accent-text);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon-btn {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    border-color: color-mix(in oklab, currentColor 25%, transparent);
    transition: border-color 0.2s, color 0.2s;
  }
  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  :global([data-theme='light']) .moon,
  :global([data-theme='dark']) .sun {
    display: none;
  }
  .menu-btn {
    display: none;
    position: relative;
  }
  .menu-btn span {
    position: absolute;
    left: 9px;
    right: 9px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-btn span:nth-child(1) {
    top: 11px;
  }
  .menu-btn span:nth-child(2) {
    top: 16px;
  }
  .menu-btn span:nth-child(3) {
    top: 21px;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile {
    height: calc(100svh - var(--top-h, var(--header-h)));
    padding: 24px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile li a {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.01em;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1040px) {
    .nav,
    .tools :global(.head-social) {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
</style>
