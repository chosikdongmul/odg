---
import type { Person } from '../lib/schema';

interface Props {
  links: Person['socials'];
  class?: string;
}
const { links, class: cls } = Astro.props;

const icons: Record<string, { label: string; d?: string }> = {
  x: { label: 'X', d: 'M17.8 3H21l-7 8 8.2 10h-6.4l-5-6.5L5 21H1.8l7.5-8.6L1.4 3H8l4.6 6zm-1.1 16.2h1.8L7.3 4.7H5.4z' },
  instagram: {
    label: 'Instagram',
    d: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1C3.6 15 3.6 14.7 3.6 12s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.1 4.2-.1zM12 2C9.3 2 8.9 2 7.9 2.1 4.2 2.2 2.2 4.2 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15.1 2 14.7 2 12 2z',
  },
  youtube: {
    label: 'YouTube',
    d: 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15V9l5.8 3z',
  },
  chzzk: { label: 'CHZZK' },
  soop: { label: 'SOOP' },
};
const entries = Object.entries(links ?? {}).filter(([k, v]) => v && icons[k]);
---

{
  entries.length > 0 && (
    <ul class:list={['social', cls]}>
      {entries.map(([k, href]) => (
        <li>
          <a href={href} target="_blank" rel="noopener" aria-label={icons[k].label}>
            {icons[k].d ? (
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d={icons[k].d} fill="currentColor" />
              </svg>
            ) : (
              <span class="label">{icons[k].label}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  a {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding-inline: 6px;
    opacity: 0.7;
    transition: opacity 0.2s, color 0.2s;
  }
  a:hover {
    opacity: 1;
    color: var(--accent-text);
  }
  svg {
    width: 16px;
    height: 16px;
  }
  .label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
</style>
