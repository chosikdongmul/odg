---
import { Image } from 'astro:assets';
import { champIcon, champName, img, pad2, people, roleKo, tx } from '../lib/data';
import { ROLES } from '../lib/roles';
import LaneIcon from './LaneIcon.astro';
import Social from './Social.astro';

const P = tx.profile;
const statLabels: [keyof (typeof people)[number]['stats'], string, string?][] = [
  ['games', P.games],
  ['winRate', P.winRate, '%'],
  ['kda', P.kda],
  ['kills', P.kills],
  ['deaths', P.deaths],
  ['assists', P.assists],
  ['cs', P.cs],
];
---

{
  people.map((p, i) => {
    const role = ROLES[p.role];
    const photo = img(p.photoSide ?? p.photo);
    const stats = statLabels.filter(([k]) => p.stats[k] != null);
    const age = p.birthYear ? new Date().getFullYear() - p.birthYear : undefined;
    const prev = people[(i - 1 + people.length) % people.length];
    const next = people[(i + 1) % people.length];
    return (
      <dialog class="modal" id={`p-${p.id}`} data-person={p.id} aria-labelledby={`p-${p.id}-name`}>
        <div class="sheet">
          <div class="visual photo-panel">
            {photo && (
              <Image
                src={photo}
                alt={`${p.nickname} ${p.nameKo}`}
                widths={[480, 800, 1200]}
                sizes="(max-width: 900px) 100vw, 45vw"
                class="horizon"
                style={`object-position: 50% ${p.focusY}%`}
                loading="lazy"
              />
            )}
          </div>

          <div class="info">
            <p class="role">
              {role.kind === 'player' && <LaneIcon role={p.role} size={16} />}
              {roleKo(p.role)}
              {p.number != null && <span class="muted">· No.{pad2(p.number)}</span>}
            </p>
            <h2 class="nick display" id={`p-${p.id}-name`}>
              {p.nickname}
            </h2>
            <p class="names">
              {p.nameKo}
              {p.nameEn && <span class="muted">{p.nameEn}</span>}
            </p>

            <dl class="facts">
              {age && (
                <div>
                  <dt>{P.age}</dt>
                  <dd>{age}</dd>
                </div>
              )}
              <div>
                <dt>{P.nation}</dt>
                <dd>{p.nationality}</dd>
              </div>
              {p.joined && (
                <div>
                  <dt>{P.joined}</dt>
                  <dd>{p.joined}</dd>
                </div>
              )}
            </dl>

            {p.quote && <blockquote class="quote">{p.quote}</blockquote>}

            {stats.length > 0 && (
              <section>
                <h3 class="h">{P.stats}</h3>
                <dl class="stats">
                  {stats.map(([k, label, unit]) => (
                    <div>
                      <dd class="num">
                        {p.stats[k]}
                        {unit}
                      </dd>
                      <dt>{label}</dt>
                    </div>
                  ))}
                </dl>
              </section>
            )}

            {p.champions.length > 0 && (
              <section>
                <h3 class="h">{P.champions}</h3>
                <ul class="champs">
                  {p.champions.map((c) => (
                    <li>
                      <img src={champIcon(c.name)} alt="" width="40" height="40" loading="lazy" />
                      <span class="c-name">{champName(c.name)}</span>
                      <span class="c-rec muted">
                        {c.games}{P.games} · {c.games ? Math.round((c.wins / c.games) * 100) : 0}%
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {p.career.length > 0 && (
              <section>
                <h3 class="h">{P.career}</h3>
                <ol class="rows">
                  {p.career.map((c) => (
                    <li>
                      <span class="muted">{c.period}</span>
                      <span>{c.team}</span>
                      <span class="muted">{c.role}</span>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {p.awards.length > 0 && (
              <section>
                <h3 class="h">{P.awards}</h3>
                <ul class="rows">
                  {p.awards.map((a) => (
                    <li>
                      <span class="muted">{a.year}</span>
                      <span>{a.title}</span>
                      <span />
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <Social links={p.socials} />
          </div>

          <nav class="pager" aria-label="다른 멤버">
            <button type="button" data-go={prev.id}>
              ← {prev.nickname}
            </button>
            <span class="num muted">
              {i + 1} / {people.length}
            </span>
            <button type="button" data-go={next.id}>
              {next.nickname} →
            </button>
          </nav>
          <button type="button" class="close" data-close aria-label="닫기">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </button>
        </div>
      </dialog>
    );
  })
}

<script>
  let current: HTMLDialogElement | null = null;

  function open(id: string, push = true) {
    const dlg = document.getElementById(`p-${id}`) as HTMLDialogElement | null;
    if (!dlg) return;
    if (current && current !== dlg) current.close();
    if (!dlg.open) dlg.showModal();
    dlg.querySelector('.info')?.scrollTo(0, 0);
    current = dlg;
    if (push) history.replaceState(null, '', `#p-${id}`);
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest<HTMLElement>('[data-open]');
    if (opener) return open(opener.dataset.open!);
    const go = t.closest<HTMLElement>('dialog [data-go]');
    if (go) return open(go.dataset.go!);
    if (t.closest('[data-close]')) return current?.close();
    if (t instanceof HTMLDialogElement && t.open) t.close(); // 바깥 클릭
  });

  document.querySelectorAll<HTMLDialogElement>('dialog[data-person]').forEach((d) => {
    d.addEventListener('close', () => {
      if (current === d) current = null;
      if (!current && location.hash.startsWith('#p-')) history.replaceState(null, '', location.pathname + location.search);
    });
    d.addEventListener('keydown', (e) => {
      const [prev, next] = d.querySelectorAll<HTMLElement>('.pager [data-go]');
      if (e.key === 'ArrowRight') next.click();
      if (e.key === 'ArrowLeft') prev.click();
    });
  });

  // 주소에 #p-아이디 가 있으면 바로 연다 (공유 링크)
  const fromHash = () => {
    const m = location.hash.match(/^#p-([a-z0-9-]+)$/);
    if (m) open(m[1], false);
  };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>

<style>
  .modal {
    padding: 0;
    border: 1px solid var(--line2);
    width: min(1080px, 100vw - 32px);
    max-width: none;
    height: min(760px, 100svh - 32px);
    max-height: none;
    background: var(--bg2);
    color: var(--text);
    overflow: hidden;
  }
  .modal::backdrop {
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(4px);
  }
  .modal[open] {
    animation: fade 0.25s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .sheet {
    position: relative;
    display: grid;
    grid-template-columns: 44% 1fr;
    height: 100%;
  }
  .visual :global(img) {
    position: absolute;
    inset: 0;
  }
  .info {
    overflow-y: auto;
    padding: 44px 40px 88px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    overscroll-behavior: contain;
  }
  .role {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }
  .role .muted {
    margin-left: 2px;
  }
  .nick {
    font-size: clamp(44px, 5vw, 64px);
    margin: -18px 0 -14px;
  }
  .names {
    display: flex;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
  }
  .names .muted {
    font-weight: 400;
  }
  .facts {
    display: flex;
    gap: 36px;
  }
  .facts dt {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .facts dd {
    font-weight: 600;
  }
  .quote {
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--accent);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.55;
  }
  .h {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--muted);
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    padding: 14px 6px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats dd {
    font-size: 22px;
    font-weight: 800;
  }
  .stats dt {
    font-size: 11px;
    color: var(--muted);
  }
  .h + .stats {
    margin-top: -14px;
    border-top: 0;
  }
  .champs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .champs li {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 10px;
    align-items: center;
  }
  .champs img {
    grid-row: span 2;
    width: 40px;
    height: 40px;
  }
  .c-name {
    font-weight: 700;
    font-size: 14px;
  }
  .c-rec {
    font-size: 12px;
  }
  .rows li {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .pager {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 56%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: 8px;
    background: var(--bg2);
    border-top: 1px solid var(--line);
    font-size: 13px;
  }
  .pager button {
    padding: 8px 14px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .pager button:hover {
    color: var(--accent-text);
  }
  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line2);
    background: var(--bg2);
    transition: border-color 0.2s, color 0.2s;
  }
  .close:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  @media (max-width: 900px) {
    .modal {
      width: 100vw;
      height: 100svh;
      border: 0;
    }
    .sheet {
      display: block;
      overflow-y: auto;
    }
    .visual {
      height: 58svh;
    }
    .info {
      overflow: visible;
      padding: 32px var(--gutter) 88px;
    }
    .pager {
      position: sticky;
      width: 100%;
    }
  }
</style>
