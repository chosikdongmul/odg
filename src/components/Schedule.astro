---
import { dow, hm, md, team, tx, upcoming } from '../lib/data';
import SectionHead from './SectionHead.astro';

const [next, ...rest] = upcoming;
const fmt = { bo1: 'BO1', bo3: 'BO3', bo5: 'BO5' } as const;
const T = tx.schedule;
---

<section class="section" id="schedule">
  <div class="wrap">
    <SectionHead label={T.label} title={T.title} aside={T.aside} />

    {
      next ? (
        <article class:list={['next', next.status === 'live' && 'live']} data-countdown={next.when.valueOf()}>
          <div class="next-meta">
            <p class="eyebrow tag">{next.status === 'live' ? T.live : T.next}</p>
            <p class="muted small">
              {next.league}
              {next.stage && ` · ${next.stage}`} · {fmt[next.format]}
            </p>
          </div>
          <div class="versus">
            <span class="team display">{team.shortName}</span>
            <span class="x muted">VS</span>
            <span class="team display">{next.opponentShort || next.opponent}</span>
          </div>
          <div class="next-side">
            <p class="when num">
              {md(next.when)} <span class="muted">({dow(next.when)})</span> {hm(next.when)}
            </p>
            <p class="clock num" data-clock />
            {next.broadcast && (
              <a class="btn solid" href={next.broadcast} target="_blank" rel="noopener">
                {next.status === 'live' ? T.watchLive : T.watch}
              </a>
            )}
          </div>
        </article>
      ) : (
        <p class="muted">{T.empty}</p>
      )
    }

    {
      rest.length > 0 && (
        <ol class="rows">
          {rest.map((m) => (
            <li>
              <span class="num d">{md(m.when)}</span>
              <span class="opp">
                vs {m.opponent}
                <span class="league eyebrow">{m.stage ?? m.league}</span>
              </span>
              <span class="t num muted">
                {dow(m.when)} {hm(m.when)} {T.timezone}
              </span>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>

<script>
  const card = document.querySelector<HTMLElement>('[data-countdown]');
  const clock = card?.querySelector<HTMLElement>('[data-clock]');
  if (card && clock) {
    const at = Number(card.dataset.countdown);
    const p = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const ms = at - Date.now();
      if (card.classList.contains('live')) return void (clock.textContent = 'ON AIR');
      if (ms <= 0) return void (clock.textContent = 'MATCH DAY');
      const d = Math.floor(ms / 864e5);
      const h = Math.floor((ms % 864e5) / 36e5);
      const m = Math.floor((ms % 36e5) / 6e4);
      const s = Math.floor((ms % 6e4) / 1e3);
      clock.textContent = `D-${d} · ${p(h)}:${p(m)}:${p(s)}`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .next {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 32px 36px;
    background: var(--bg2);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
  }
  .tag {
    color: var(--accent-text);
    margin-bottom: 6px;
  }
  .live .tag {
    animation: blink 1.2s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .small {
    font-size: 13px;
  }
  .versus {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .team {
    font-size: clamp(34px, 4.4vw, 56px);
  }
  .x {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  .next-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .when {
    font-size: 18px;
  }
  .when .muted {
    font-family: var(--f-sans);
    font-size: 13px;
    font-weight: 400;
  }
  .clock {
    font-size: 14px;
    color: var(--accent-text);
    margin-bottom: 8px;
  }
  .rows {
    margin-top: 12px;
  }
  .rows li {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 18px 8px;
    border-bottom: 1px solid var(--line);
  }
  .d {
    font-size: 15px;
  }
  .opp {
    font-weight: 700;
    font-size: 16px;
  }
  .league {
    margin-left: 10px;
    color: var(--muted);
    font-size: 10px;
  }
  .t {
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .next {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      padding: 28px 20px;
    }
    .next-side {
      align-items: center;
    }
    .rows li {
      grid-template-columns: 64px 1fr;
    }
    .t {
      grid-column: 2;
    }
    .league {
      display: block;
      margin: 4px 0 0;
    }
  }
</style>
