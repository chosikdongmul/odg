---
import { img, team, tx } from '../lib/data';
import Bolt from './Bolt.astro';
import Social from './Social.astro';

const logo = img(team.logo);
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <p class="name">
          {logo ? <span class="logo" style={`--logo:url("${logo.src}");--ratio:${logo.width / logo.height}`} /> : <Bolt />}
          {team.name}
        </p>
        <p class="meta">{team.league} · {team.city} · EST. {team.founded}</p>
        {team.slogan && <p class="slogan muted">"{team.slogan}"</p>}
      </div>
      <div class="right">
        <Social links={team.socials} />
        {team.contactEmail && <a class="mail muted" href={`mailto:${team.contactEmail}`}>{team.contactEmail}</a>}
      </div>
    </div>
    <div class="legal">
      <p>© {team.founded} {team.name}{team.nameKo && ` (${team.nameKo})`}. {tx.footer.rights}</p>
      {team.disclaimer && <p>{team.disclaimer}</p>}
      {tx.footer.riot && <p>{tx.footer.riot.replaceAll('{team}', team.name)}</p>}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: 56px;
    background: var(--bg);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 40px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 22px;
  }
  .name :global(.bolt) {
    color: var(--accent);
  }
  .logo {
    display: block;
    height: 22px;
    width: calc(22px * var(--ratio));
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .meta {
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .slogan {
    margin-top: 12px;
    font-size: 14px;
  }
  .right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .mail {
    font-size: 13px;
  }
  .mail:hover {
    color: var(--accent-text);
  }
  .legal {
    display: grid;
    gap: 6px;
    padding-block: 24px 40px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    line-height: 1.7;
    color: var(--dim);
  }
  @media (max-width: 640px) {
    .right {
      align-items: flex-start;
    }
  }
</style>
